# Makefile
# Usage: make <target>

.PHONY: help show-files show-path

# Default target
help:
	@echo "Available targets:"
	@echo "  show-files    - Show files in the current directory"
	@echo "  show-path     - Show the current path"

# Build Docker image
show-files:
	@echo "Files in the current directory:"
	ls -l

# Show current path
show-path:
	@echo "Current path:"
	pwd
